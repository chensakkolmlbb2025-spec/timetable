# Absolute Timetable - Environment Variables
# Copy this file to .env.local and replace the values with your project's keys
# IMPORTANT: .env.local is ignored by git and should NEVER be committed

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Public Supabase project URL (visible to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key for the project (safe to expose to client via NEXT_PUBLIC_ environment variable)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key (server-side only). Use only in server runtime (do NOT expose in browser)
# This key gives elevated permissions and must be stored securely.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================

# Telegram bot token for sending PDFs
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Telegram chat ID where PDFs should be sent
# Can be a user ID, group ID, or channel ID
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# ============================================================================
# CRON & SECURITY
# ============================================================================

# Secret key for protecting the /api/cron/daily-report endpoint
# Use a strong random string (e.g., openssl rand -base64 32)
CRON_SECRET="your-cron-secret-key"

# Secret key for protecting the admin UI
# Use a strong random string (e.g., openssl rand -base64 32)
ADMIN_UI_SECRET="your-admin-ui-secret"

# ============================================================================
# OPTIONAL: EXPORT USER ID
# ============================================================================

# User ID for exporting/sending reports (optional, used by debug endpoints)
# EXPORT_USER_ID="your-user-id"

# Optional: override default cookie name for server-side supabase client if needed
# SUPABASE_COOKIE_NAME="sb:token"
